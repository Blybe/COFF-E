# Copy to .env and enter the reachable Avular address (no tcp/ prefix).
REAL_ROBOT_IP=
# LOCAL domain must differ from the domain inside the robot.
LOCAL_ROS_DOMAIN_ID=42
DASHBOARD_PORT=8082
# Confirm with estimated_pose.header.frame_id and the robot documentation.
NAV_FRAME=map
# Must have type geometry_msgs/msg/PoseWithCovarianceStamped and an onboard
# subscriber. On Chud the localization listens on /initialpose.
INITIAL_POSE_TOPIC=/initialpose
# Same map selection as Simulation-Docker/.env; files are mounted read-only.
SIM_MAP=JMH - 3rd floor
# Configured target identity, not an automatic robot selector.
# Chud: RK5. Ronaldo: CR7. Verify the IP before changing target.
ROBOT_NAME=Chud
ROBOT_WIFI_SUFFIX=RK5
# Onboard map behind the "Load Chud map" button. Chud stores four maps named
# JMH-03-D07-10-26-PT-1 with the same size; this is one of them.
ROBOT_MAP_ID=b3704c57-6e5b-49dc-b121-ab55ecae9857
ROBOT_MAP_NAME=JMH-03-D07-10-26-PT-1
# Top of the dashboard's manual speed sliders (hard ceiling 1.0 m/s, 1.5 rad/s).
MANUAL_MAX_LINEAR=0.6
MANUAL_MAX_ANGULAR=1.0
