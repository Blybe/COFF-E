# Team defaults for the simulation (read automatically by docker compose).
# Map name or id from ../cerebra-data/maps (list them with:
#   py tools/cerebra_import.py --list)
CEREBRA_MAP=JMH - 3rd floor
# Waypoint on that map where the robot spawns
CEREBRA_SPAWN=Home

# ---------------------------------------------------------------------------
# How the simulation is driven (see orchestrator/targets.py, MISSION_GUIDE.md)
# ---------------------------------------------------------------------------
# direct [default] = publish /robot/cmd_vel, like the origin-nav container does
# user            = take control (control mode USER) and publish
#                   /robot/cmd_vel_user, exactly like the real Origin One.
#                   This is the way to test the real-robot command path
#                   without hardware; the simulation implements the same
#                   cmd_vel_controller as the robot.
SIM_DRIVE_MODE=direct

# ---------------------------------------------------------------------------
# The real robots: real Avular Origin One + real xArm 6
# ---------------------------------------------------------------------------
# A mission with "target: real" (or "both") needs these. The real ARM is
# already wired up above: the SDK talks to its control box directly, so arm
# steps need no bridge. For the real Avular, set its IP here and start the
# zenoh bridge - the connection to the robot's own ROS 2 network - with:
#     docker compose --profile real up -d
# While this stays empty the real target has no mobile base: drive steps on
# target real fail with a clear message, and a "both" mission drives the
# simulation while the real arm does the arm steps (sample_9_rehearsal).
#REAL_ROBOT_IP=192.168.100.1
# IP of the real xArm 6 control box (empty = this target has no arm).
# The arm speaks SDK-over-TCP directly, so it needs NO zenoh bridge: arm
# missions (target: real with arm steps only) run on it without
# --profile real. Currently connected over Ethernet, in the host's own
# subnet (the host is 192.168.1.12):
REAL_XARM_HOST=192.168.1.229
# ROS 2 domain used between the orchestrator and the zenoh bridge [42]:
#REAL_ROS_DOMAIN_ID=42
